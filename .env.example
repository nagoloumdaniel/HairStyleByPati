# ============================================================
# Hairstyle by Patricia — variables d'environnement (P0.6)
# Copier vers .env.local (dev) ou .env (prod) — NE JAMAIS
# de secret réel dans le dépôt. .env est ignoré par git.
# ============================================================

# ---------- Base de données (Neon / PostgreSQL) ----------
# Format: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"
# URL dédiée aux migrations Prisma (pool plus large) : peut être identique à DATABASE_URL
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# ---------- Application ----------
# URL publique utilisée pour les liens absolus (e-mails, annulation, OG tags)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Fuseau horaire EXPLICITE du salon (§14.4) — tout est stocké en UTC
SALON_TIMEZONE="Europe/Paris"
# Locale d'affichage des dates/heures
NEXT_PUBLIC_APP_LOCALE="fr-FR"

# ---------- Authentification (Auth.js / NextAuth) ----------
# Générer avec: openssl rand -base64 32  (ou: npx auth secret)
AUTH_SECRET="change-me-generate-32-bytes-base64"
# Utilisateur admin initial (seed P1.6) — mot de passe haché Argon2 en prod
AUTH_ADMIN_EMAIL="patricia@example.com"
# Signature des liens sensibles (annulation client, accès factures...)
TOKEN_SIGNATURE_SECRET="change-me-another-32-bytes-base64"
# Durée de validité des liens d'annulation (heures)
CANCEL_LINK_TTL_HOURS="48"

# ---------- Stockage fichiers (Cloudflare R2 — API S3) ----------
# N'exposer QUE NEXT_PUBLIC_* côté client ; tout le reste reste serveur.
S3_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="hairstyle-by-pati"
S3_ACCESS_KEY_ID="change-me"
S3_SECRET_ACCESS_KEY="change-me"
# Durée de vie des URLs signées (secondes) pour photos privées
SIGNED_URL_TTL_SECONDS="300"
# Limites d'upload (octets / formats autorisés)
UPLOAD_MAX_BYTES="5242880"
UPLOAD_ALLOWED_MIME="image/jpeg,image/png,image/webp"

# ---------- E-mails (Resend) ----------
RESEND_API_KEY="re_xxxxxxxxxxxxxxxx"
# Expéditeur vérifié dans Resend (domaine du salon)
EMAIL_FROM="Hairstyle by Patricia <bonjour@exemple.fr>"
# Adresse de réception des notifications Patricia
ADMIN_EMAIL="patricia@example.com"
# Délai de rappel avant RDV (heures) — §10.5
REMINDER_LEAD_HOURS="24"

# ---------- Monitoring (Sentry) ----------
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""

# ---------- Horaires / politique du salon (§7.4, §8) ----------
# Durée max d'un créneau réservé « en attente de confirmation » (minutes)
HOLD_SLOT_MINUTES="30"
# Délai minimal d'annulation par le client (heures)
MIN_CANCEL_NOTICE_HOURS="24"

# ---------- CI / déploiement ----------
# Défini uniquement sur Vercel/GitHub Actions, jamais en local
VERCEL="1"
